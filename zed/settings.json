// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Extensions to install automatically on a new install
  "auto_install_extensions": {
      "clice": true,
      "colored-zed-icons-theme": true,
      "comment": true,
      "gdscript": true,
      "git-firefly": true,
      "glsl": true,
      "gruber-darker": true,
      "jellybeans-vim": true,
      "just": true,
      "kanagawa-themes": true,
      "kanso": true,
      "latex": true,
      "lua": true,
      "make": true,
      "material-icon-theme": true,
      "neocmake": true,
      "odin": true,
      "pylsp": true,
      "sitruuna": true,
      "sonder-theme": true,
      "sublime-mariana-theme": true,
      "toml": true,
      "zig": true,
  },

  "profiles": {
    "macos": {
      "settings": {
        "ui_font_size": 22.0,
        "buffer_font_size": 22.0,
        "terminal": {
          "font_family":"MonaspiceNe Nerd Font",
          "shell": {
            "program": "/bin/zsh"
          }
        }
      }
    },
    "windows": {
      "settings": {
        "terminal": {
          "font_family":"MonaspiceNe Nerd Font",
          "shell": {
            "program": "pwsh.exe"
          }
        }
      }
    }
  },
  // Dont automatically show completions
  // completions can be shown with ctrl-space
  //"show_completions_on_input": false,
  "diagnostics_max_severity": "error",
  // This stops the "Unrecognised project" every time you clone something from git
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
    "git_status": false,
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": true
  },
  // Remove Godot uid and import files from appearing in the file tree
  "file_scan_exclusions": [
    "**/*.uid",
    "**/*.import"
  ],
  "agent_buffer_font_size": 16.0,
  "buffer_font_weight": 400.0,
  "ensure_final_newline_on_save": false,
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Material Icon Theme",
  },
  "disable_ai": true,
  "auto_indent": "preserve_indent",
  "base_keymap": "VSCode",
  "buffer_line_height": { "custom": 1.3 },
  "current_line_highlight": "all",
  "relative_line_numbers": "enabled",
  "preview_tabs": {
    "enabled": false,
  },
  "terminal": {
    "dock": "bottom",
    //"shell": {
    //    "program": "pwsh.exe",
    //  },
  },
  "journal": {
    "path": "C:/Users/glens/Documents",
    "hour_format": "hour24",
  },
  "tabs": {
    "file_icons": true,
  },
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": false,
    },
  },

  "format_on_save": "off",
  "buffer_font_family": "MonaspiceNe Nerd Font Mono",
  //"ui_font_family": "OCR A",
  "ui_font_size": 16.0,
  "buffer_font_size": 18.0,
  "vim_mode": true,

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "tab_bar": {
    "show": true,
  },
  "toolbar": {
    "breadcrumbs": false,
    "agent_review": false,
    "selections_menu": false,
    "code_actions": false,
    "quick_actions": false,
  },

  // Current Set theme
  "theme": "Ultimate Dark Neo",

  // Theme Customizations
  // This section applies globally to all themes.
  "experimental.theme_overrides": {
    "syntax": {
      "namespace": { "font_style": "normal", "font_weight": 400 },
      "type": { "font_style": "normal", "font_weight": 400 },
      "boolean": { "font_style": "normal", "font_weight": 400 },
      "class": { "font_style": "normal", "font_weight": 400 },
      "enum": { "font_style": "normal", "font_weight": 400 },
      "interface": { "font_style": "normal", "font_weight": 400 },
      "struct": { "font_style": "normal", "font_weight": 400 },
      "typeParameter": { "font_style": "normal", "font_weight": 400 },
      "parameter": { "font_style": "normal", "font_weight": 400 },
      "variable": { "font_style": "normal", "font_weight": 400 },
      "property": { "font_style": "normal", "font_weight": 400 },
      "enumMember": { "font_style": "normal", "font_weight": 400 },
      "function": { "font_style": "normal", "font_weight": 400 },
      "method": { "font_style": "normal", "font_weight": 400 },
      "macro": { "font_style": "normal", "font_weight": 400 },
      "keyword": { "font_style": "normal", "font_weight": 400 },
      "comment": { "font_style": "normal", "font_weight": 400 },
      "string": { "font_style": "normal", "font_weight": 400 },
      "number": { "font_style": "normal", "font_weight": 400 },
      "operator": { "font_style": "normal", "font_weight": 400 },
      "punctuation.bracket": { "font_style": "normal", "font_weight": 400 },
      "text.literal": { "font_style": "normal", "font_weight": 400 },
    },
  },
  "theme_overrides": {
    "Sitruuna": {
      "editor.line_number": "#666666",
      "panel.background": "#151515",
      "syntax": {
        "comment": { "color": "#6f7b68" },
        "string": { "color": "#5FC385" },
      },
    },
    "Kanso Ink (No italics)": {
      //"editor.line_number": "#666666",
      "panel.background": "#050505",
      "editor.background": "#050505",
      "editor.gutter.background": "#050505",
      "title_bar.background": "#050505",
      "tab_bar.background": "#050505",
      "terminal.background": "#050505",
      "syntax": {
        //"comment": { "color": "#6f7b68" },
        //"string": { "color": "#5FC385" },
      },
    },
    "Kanso Zen (No italics)": {
      //"editor.line_number": "#666666",
      "panel.background": "#050505",
      "editor.background": "#050505",
      "editor.gutter.background": "#050505",
      "title_bar.background": "#050505",
      "tab_bar.background": "#050505",
      "terminal.background": "#050505",
      "syntax": {
        //"comment": { "color": "#6f7b68" },
        //"string": { "color": "#5FC385" },
      },
    },
    "Kujukuju": {
      "editor.background": "#080B14",
      "editor.gutter.background": "#080B14",
      "title_bar.background": "#080B14"
    },
    "Kanagawa Wave - No Italics": {
      "panel.background": "#121212",
      "editor.background": "#121212",
      "editor.gutter.background": "#121212",
      "syntax": {
        "comment": { "color": "#6f7b68" },
        "string": { "color": "#5FC385" },
      },
    },
    "Gruber Darker": {
      "title_bar.background": "#050505",
      "tab_bar.background": "#050505",
      "tab.inactive_background": "#202020",
      "tab.active_background": "#333333",
      "toolbar.background": "#050505",
      "status_bar.background": "#050505",
      "panel.background": "#050505",
      "editor.background": "#050505",
      //"editor.active_line.background": "#111144",
      "editor.gutter.background": "#050505",
      "terminal.background": "#050505",
      "syntax": {
        "comment": { "color": "#6f7b68" },
        "meta.preprocessor": { "font_weight": 400 },
      },
    },
    "Ultimate Dark Neo" : {
      "title_bar.background": "#101010",
      "tab_bar.background": "#101010",
      "tab.inactive_background": "#101010",
      "tab.active_background": "#333333",
      "toolbar.background": "#101010",
      "status_bar.background": "#101010",
      "panel.background": "#101010",
      "editor.background": "#101010",
      //"editor.active_line.background": "#111144",
      "editor.gutter.background": "#101010",
      "terminal.background": "#101010",
      "syntax" : {
      }
    },
    "Sonder": {
      "title_bar.background": "#050505",
      "tab_bar.background": "#050505",
      "tab.inactive_background": "#202020",
      "tab.active_background": "#333333",
      "toolbar.background": "#050505",
      "status_bar.background": "#050505",
      "panel.background": "#050505",
      "editor.background": "#050505",
      //"editor.active_line.background": "#111144",
      "editor.gutter.background": "#050505",
      "terminal.background": "#050505",
      "syntax": {
        "comment": { "color": "#6f7b68" },
        "meta.preprocessor": { "font_weight": 400 },
      },
    },
    "Jellybeans": {
      "editor.line_number": "#666666",
      "panel.background": "#151515",
      "players": [{ "cursor": "#8e8e8e" }],
      "syntax": {
        "comment": {
          "color": "#6f7b68",
          "font_style": "normal",
        },
      },
    },
    "Sublime Mariana": {
      "title_bar.background": "#050505",
      "elevated_surface.background": "#252525",
      "border": "#333333",
      "tab_bar.background": "#050505",
      "tab.inactive_background": "#202020",
      "tab.active_background": "#333333",
      "toolbar.background": "#050505",
      "status_bar.background": "#050505",
      "panel.background": "#050505",
      "panel.focused_border": "#666666",
      "pane.focused_border": "#666666",
      "editor.background": "#050505",
      "editor.foreground": "#666666",
      "editor.active_line.background": "#1A3C49",
      "editor.gutter.background": "#050505",
      "terminal.background": "#050505",
      "players": [{ "cursor": "#00ff33" }],
    },
    "haku-dark": {
      "title_bar.background": "#181818",
      "syntax": {
        "punctuation.bracket" : {"color": "#9Cb8d1"},
      }
    },
    "Melange Dark": {
      "title_bar.background": "#050505",
      "elevated_surface.background": "#252525",
      "text": "#ece1d7ff",
      "text.muted": "#ece1d7ff",
      "text.placeholder": "#ece1d7ff",
      "text.disabled": "#ece1d7ff",
      "text.accent": "#ece1d7ff",
      "border": "#333333",
      "tab_bar.background": "#050505",
      "tab.inactive_background": "#202020",
      "tab.active_background": "#333333",
      "toolbar.background": "#050505",
      "status_bar.background": "#050505",
      "panel.background": "#050505",
      "panel.focused_border": "#666666",
      "pane.focused_border": "#666666",
      "editor.background": "#050505",
      "editor.foreground": "#666666",
      "editor.active_line.background": "#111144",
      "editor.gutter.background": "#050505",
      "terminal.background": "#050505",
      "players": [{ "cursor": "#00ff33" }],
      "syntax": {
        "comment": { "color": "#6f7b68" },
        "punctuation.bracket": { "color": "#666666" },
      },
    },
  },
  "languages": {
    "Zig": {
      // Formatting with ZLS matches `zig fmt`.
      // The Zig FAQ answers some questions about `zig fmt`:
      // https://github.com/ziglang/zig/wiki/FAQ
      "format_on_save": "off",
      // Make sure that zls is the primary language server
      "language_servers": ["zls", "..."],
    },
    "C++": {
      "enable_language_server": true,
      "tab_size": 4,
      "hard_tabs": false,
    },
  },
  "lsp": {
    "ols": {
      "binary": {
        "path": "G:/Programs/ols/ols.exe"
      }
    },
    "clangd": {
      "binary": {
        "path": "G:/dev_tools/LLVM/bin/clangd.exe",
        "arguments": [
          "--background-index",
          "--pch-storage=memory",
          "--header-insertion=never",
          "-j=4",
        ],
      },
    },
    "zls": {
      "binary": {
        // omit the following line if `zls` is in your PATH
        "path": "C:\\Users\\glens\\.zvm\\bin\\zls.exe",
      },
      // There are two ways to set config options:
      //   - edit your `zls.json` that applies to any editor that uses ZLS
      //   - set in-editor config options with the `settings` field below.
      //
      // Further information on how to configure ZLS:
      // https://zigtools.org/zls/configure/
      "settings": {
        "zls": {
          // Whether to enable build-on-save diagnostics
          //
          // Further information about build-on save:
          // https://zigtools.org/zls/guides/build-on-save/
          // "enable_build_on_save": true,

          // omit the following line if `zig` is in your PATH
          "zig_exe_path": "C:\\Users\\glens\\.zvm\\bin\\zig.exe",
        },
      },
    },
  },

  "dap": {
    "CodeLLDB": {
      "binary": "G:/dev_tools/LLVM/bin/lldb.exe"
    }
  }
}

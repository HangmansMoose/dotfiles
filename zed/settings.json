// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Extensions to install automatically on a new install
  "auto_install_extensions": {
      "chaos-theory-theme": true,
      "codesandbox-theme": true,
      "colored-zed-icons-theme": true,
      "gdscript": true,
      "gruber-darker": true,
      "haku-dark-theme": true,
      "html": true,
      "jellybeans-vim": true,
      "kanagawa-themes": true,
      "kanso": true,
      "lua": true,
      "make": true,
      "material-icon-theme": true,
      "melange": true,
      "naysayer-theme": true,
      "neocmake": true,
      "oceanic-next": true,
      "odin": true,
      "pylsp": true,
      "sitruuna": true,
      "sublime-mariana-theme": true,
      "toml": true,
      "tomorrow-theme": true,
      "vscode-icons": true,
      "zig": true,
  },

  "profiles": {
    "macos": {
      "settings": {
        "ui_font_size": 22.0,
        "buffer_font_size": 22.0,
        "terminal": {
          "shell": {
            "program": "/usr/bin/fish"
          }
        }
      }
    }
  },

  "diagnostics_max_severity": "off",
  // This stops the "Unrecognised project" every time you clone something from git
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
    "git_status": false,
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": true
  },
  // Remove Godot uid and import files from appearing in the file tree
  "file_scan_exclusions": [
    "**/*.uid",
    "**/*.import"
  ],
  "agent_buffer_font_size": 16.0,
  "buffer_font_weight": 400.0,
  "ensure_final_newline_on_save": false,
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Material Icon Theme",
  },
  "disable_ai": true,
  "auto_indent": "none",
  "base_keymap": "VSCode",
  "buffer_line_height": { "custom": 1.3 },
  "current_line_highlight": "all",
  "relative_line_numbers": "enabled",
  "preview_tabs": {
    "enabled": false,
  },
  "terminal": {
    "dock": "bottom",
    "shell": {
        "program": "pwsh.exe",
      },
    },
  "journal": {
    "path": "C:/Users/glens/Documents",
    "hour_format": "hour24",
  },
  "tabs": {
    "file_icons": true,
  },
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": false,
    },
  },

  "format_on_save": "off",
  "buffer_font_family": "CaskaydiaMono Nerd Font",
  //"ui_font_family": "Segoe UI",
  "ui_font_size": 16.0,
  "buffer_font_size": 17.0,
  "vim_mode": true,

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "tab_bar": {
    "show": true,
  },
  "toolbar": {
    "breadcrumbs": false,
    "agent_review": false,
    "selections_menu": false,
    "code_actions": false,
    "quick_actions": false,
  },

  // Current Set theme
  "theme": "Kujukuju Darker",

  // Theme Customizations
  // This section applies globally to all themes.
  "experimental.theme_overrides": {
    //"editor.active_line.background": "#111155",
    //"editor.highlighted_line.background": "#111155",
    //"search.match_background": "#FFA717",
    //"editor.document_highlight.bracket_background": "#404040",
    //"editor.document_highlight.read_background": "#505050",
    //"editor.document_highlight.write_background": "#505050",
    "syntax": {
      "comment": { "font_style": "normal", "font_weight": 400 },
      "punctuation.bracket": { "font_style": "normal", "font_weight": 400 },
      "meta": { "font_style": "normal", "font_weight": 400 },
      "meta.block": { "font_style": "normal", "font_weight": 400 },
      "meta.cast": { "font_style": "normal", "font_weight": 400 },
      "meta.class": { "font_style": "normal", "font_weight": 400 },
      "meta.function": { "font_style": "normal", "font_weight": 400 },
      "meta.function-call": { "font_style": "normal", "font_weight": 400 },
      "meta.preprocessor": { "font_style": "normal", "font_weight": 400 },
      "meta.return-type": { "font_style": "normal", "font_weight": 400 },
      "meta.selector": { "font_style": "normal", "font_weight": 400 },
      "meta.tag": { "font_style": "normal", "font_weight": 400 },
      "meta.type.annotation": { "font_style": "normal", "font_weight": 400 },
      "meta.type": { "font_style": "normal", "font_weight": 400 },
      "punctuation.definition.string.begin": {
        "font_style": "normal",
        "font_weight": 400,
      },
      "punctuation.definition.string.end": {
        "font_style": "normal",
        "font_weight": 400,
      },
      "punctuation.definition.comment": {
        "font_style": "normal",
        "font_weight": 400,
      },
      "punctuation.separator": { "font_style": "normal", "font_weight": 400 },
      "punctuation.separator.continuation": {
        "font_style": "normal",
        "font_weight": 400,
      },
      "punctuation.terminator": { "font_style": "normal", "font_weight": 400 },
      "storage": { "font_style": "normal", "font_weight": 400 },
      "storage.modifier": { "font_style": "normal", "font_weight": 400 },
      "storage.type": { "font_style": "normal", "font_weight": 400 },
      "storage.type.modifier": { "font_style": "normal", "font_weight": 400 },
      "string": { "font_style": "normal", "font_weight": 400 },
      "string.interpolated": { "font_style": "normal", "font_weight": 400 },
      "string.other": { "font_style": "normal", "font_weight": 400 },
      "string.quoted": { "font_style": "normal", "font_weight": 400 },
      "string.quoted.double": { "font_style": "normal", "font_weight": 400 },
      "string.quoted.other": { "font_style": "normal", "font_weight": 400 },
      "string.quoted.single": { "font_style": "normal", "font_weight": 400 },
      "string.quoted.triple": { "font_style": "normal", "font_weight": 400 },
      "string.regexp": { "font_style": "normal", "font_weight": 400 },
      "string.unquoted": { "font_style": "normal", "font_weight": 400 },
      "strong": { "font_style": "normal", "font_weight": 400 },
      "support": { "font_style": "normal", "font_weight": 400 },
      "support.class": { "font_style": "normal", "font_weight": 400 },
      "support.constant": { "font_style": "normal", "font_weight": 400 },
      "support.function": { "font_style": "normal", "font_weight": 400 },
      "support.other": { "font_style": "normal", "font_weight": 400 },
      "support.type": { "font_style": "normal", "font_weight": 400 },
      "support.type.property-name": {
        "font_style": "normal",
        "font_weight": 400,
      },
      "support.variable": { "font_style": "normal", "font_weight": 400 },
      "variable": { "font_style": "normal", "font_weight": 400 },
      "variable.language": { "font_style": "normal", "font_weight": 400 },
      "variable.name": { "font_style": "normal", "font_weight": 400 },
      "variable.other": { "font_style": "normal", "font_weight": 400 },
      "variable.other.readwrite": {
        "font_style": "normal",
        "font_weight": 400,
      },
      "variable.parameter": { "font_style": "normal", "font_weight": 400 },
    },
  },
  "theme_overrides": {
    "Sitruuna": {
      "editor.line_number": "#666666",
      "panel.background": "#151515",
      "syntax": {
        "comment": { "color": "#6f7b68" },
        "string": { "color": "#5FC385" },
      },
    },
    "Kujukuju": {
      "editor.background": "#080B14",
      "editor.gutter.background": "#080B14",
      "title_bar.background": "#080B14"
    },
    "Kanagawa Wave - No Italics": {
      "panel.background": "#121212",
      "editor.background": "#121212",
      "editor.gutter.background": "#121212",
      "syntax": {
        "comment": { "color": "#6f7b68" },
        "string": { "color": "#5FC385" },
      },
    },
    "Gruber Darker": {
      "title_bar.background": "#050505",
      "tab_bar.background": "#050505",
      "tab.inactive_background": "#202020",
      "tab.active_background": "#333333",
      "toolbar.background": "#050505",
      "status_bar.background": "#050505",
      "panel.background": "#050505",
      "editor.background": "#050505",
      //"editor.active_line.background": "#111144",
      "editor.gutter.background": "#050505",
      "terminal.background": "#050505",
      "syntax": {
        "comment": { "color": "#6f7b68" },
        "meta.preprocessor": { "font_weight": 400 },
      },
    },
    "Jellybeans": {
      "editor.line_number": "#666666",
      "panel.background": "#151515",
      "syntax": {
        "comment": {
          "color": "#6f7b68",
          "font_style": "normal",
        },
      },
    },
    "Zedokai Darker Classic": {
      "editor.background": "#101010",
      "panel.background": "#101010",
      "editor.gutter.background": "#101010",
      "syntax": {
        "comment": {
          "font_style": "normal",
        },
      },
    },
    "Sublime Mariana": {
      "title_bar.background": "#151515",
      "elevated_surface.background": "#252525",
      "border": "#333333",
      "tab_bar.background": "#151515",
      "tab.inactive_background": "#202020",
      "tab.active_background": "#333333",
      "toolbar.background": "#151515",
      "status_bar.background": "#151515",
      "panel.background": "#151515",
      "panel.focused_border": "#666666",
      "pane.focused_border": "#666666",
      "editor.background": "#151515",
      "editor.foreground": "#666666",
      "editor.active_line.background": "#111144",
      "editor.gutter.background": "#151515",
      "terminal.background": "#151515",
      "players": [{ "cursor": "#00ff33" }],
    },
    "Haku Dark": {
      "editor.active_line.background": "#0000FF33",
    },
    "Melange Dark": {
      "title_bar.background": "#050505",
      "elevated_surface.background": "#252525",
      "text": "#ece1d7ff",
      "text.muted": "#ece1d7ff",
      "text.placeholder": "#ece1d7ff",
      "text.disabled": "#ece1d7ff",
      "text.accent": "#ece1d7ff",
      "border": "#333333",
      "tab_bar.background": "#050505",
      "tab.inactive_background": "#202020",
      "tab.active_background": "#333333",
      "toolbar.background": "#050505",
      "status_bar.background": "#050505",
      "panel.background": "#050505",
      "panel.focused_border": "#666666",
      "pane.focused_border": "#666666",
      "editor.background": "#050505",
      "editor.foreground": "#666666",
      "editor.active_line.background": "#111144",
      "editor.gutter.background": "#050505",
      "terminal.background": "#050505",
      "players": [{ "cursor": "#00ff33" }],
      "syntax": {
        "comment": { "color": "#6f7b68" },
        "punctuation.bracket": { "color": "#666666" },
      },
    },
  },
  "languages": {
    "Zig": {
      // Formatting with ZLS matches `zig fmt`.
      // The Zig FAQ answers some questions about `zig fmt`:
      // https://github.com/ziglang/zig/wiki/FAQ
      "format_on_save": "off",
      // Make sure that zls is the primary language server
      "language_servers": ["zls", "..."],
    },
    "C++": {
      "enable_language_server": true,
      "tab_size": 4,
      "hard_tabs": false,
    },
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "G:/dev_tools/LLVM/bin/clangd.exe",
        "arguments": [
          "--background-index",
          "--pch-storage=memory",
          "--header-insertion=never",
          "-j=4",
        ],
      },
    },
    "zls": {
      "binary": {
        // omit the following line if `zls` is in your PATH
        "path": "C:\\Users\\glens\\.zvm\\bin\\zls.exe",
      },
      // There are two ways to set config options:
      //   - edit your `zls.json` that applies to any editor that uses ZLS
      //   - set in-editor config options with the `settings` field below.
      //
      // Further information on how to configure ZLS:
      // https://zigtools.org/zls/configure/
      "settings": {
        "zls": {
          // Whether to enable build-on-save diagnostics
          //
          // Further information about build-on save:
          // https://zigtools.org/zls/guides/build-on-save/
          // "enable_build_on_save": true,

          // omit the following line if `zig` is in your PATH
          "zig_exe_path": "C:\\Users\\glens\\.zvm\\bin\\zig.exe",
        },
      },
    },
  },

  "dap": {
    "CodeLLDB": {
      "binary": "G:/dev_tools/LLVM/bin/lldb.exe"
    }
  }
}

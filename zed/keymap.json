[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-`": "terminal_panel::Toggle",
      "ctrl-`": "terminal_panel::ToggleFocus",
      "alt-b": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "f3": ["task::Spawn",
        { "task_name": "premake" }
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-b": [
        "task::Spawn",
        {
          "task_name": "build"
        }
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-shift-m": ["task::Spawn",
        { "task_name": "hot_reload" }
      ]
    }
  },

  {
    "context": "Workspace",
    "bindings": {
      "alt-shift-c": ["task::Spawn",
        { "task_name": "clean" }
      ]
    }
  },
  // Launch External Debugger
  {
    "context": "Workspace",
    "bindings": {
      "alt-d": ["task::Spawn",
        { "task_name": "debug" }
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-shift-b": "outline_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-b": "outline_panel::ToggleFocus"
    }
  }
]

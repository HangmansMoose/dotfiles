        "tab.inactive_background": "#050505",
        "tab.active_background": "#050505",

        "search.match_background": "#315268",

        "scrollbar.track.background": "#050505",
        "scrollbar.track.border": "#2d364026",
        "scrollbar.thumb.background": "#2d3640aa",
        "scrollbar.thumb.hover_background": "#b09573",
        "scrollbar.thumb.border": "#2d364026",

        "link_text.hover": "#6b8e23",

        "conflict": "#e3811c",

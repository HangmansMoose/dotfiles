        "conflict.border": "#e3811c40",
        "created": "#6b8e23",
        "created.background": "#6b8e2320",
        "created.border": "#6b8e2340",
        "deleted": "#3a0000",
        "deleted.background": "#3a000060",
        "deleted.border": "#ff000040",
        "modified": "#d8a51d",
        "modified.background": "#d8a51d20",
        "modified.border": "#d8a51d40",
        "error": "#ff0000",
        "error.background": "#3a0000",
        "error.border": "#ff000060",
        "warning": "#e3811c",
        "warning.background": "#e3811c20",
        "warning.border": "#e3811c40",
        "success": "#6b8e23",
        "success.background": "#6b8e2320",
        "success.border": "#6b8e2340",
        "hint": "#686868",
        "hint.background": "#68686820",
        "hint.border": "#68686840",
        "hidden": "#686868",
        "predictive": "#5b4d3c",
        "ignored": "#5b4d3c",
        "unreachable": "#5b4d3c",

        "terminal.background": "#050505",
        "terminal.foreground": "#a08563",
        "terminal.ansi.black": "#050505",
        "terminal.ansi.red": "#ff0000",
        "terminal.ansi.green": "#6b8e23",
        "terminal.ansi.yellow": "#d8a51d",
        "terminal.ansi.blue": "#478980",
        "terminal.ansi.magenta": "#cc5735",
        "terminal.ansi.cyan": "#9ba290",
        "terminal.ansi.white": "#a08563",
        "terminal.ansi.bright_black": "#686868",
        "terminal.ansi.bright_red": "#ff4444",
        "terminal.ansi.bright_green": "#00ee00",
        "terminal.ansi.bright_yellow": "#ee7700",
        "terminal.ansi.bright_blue": "#6b8e23",
        "terminal.ansi.bright_magenta": "#d8a51d",
        "terminal.ansi.bright_cyan": "#b09573",

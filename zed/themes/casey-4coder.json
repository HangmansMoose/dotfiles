{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Casey (4coder)",
  "author": "Casey Muratori (ported from theme-casey.4coder)",
  "themes": [
    {
      "name": "Casey (4coder)",
      "appearance": "dark",
      "style": {
        "background": "#050505",
        "elevated_surface.background": "#101010",
        "surface.background": "#050505",
        "panel.background": "#050505",
        "panel.focused_border": "#b09573",

        "border": "#2d3640",
        "border.variant": "#050505",
        "border.focused": "#b09573",
        "border.selected": "#d8a51d",
        "border.transparent": "#00000000",
        "border.disabled": "#2d3640",

        "editor.background": "#050505",
        "editor.foreground": "#a08563",
        "editor.gutter.background": "#050505",
        "editor.line_number": "#404040",
        "editor.active_line_number": "#a08563",
        "editor.active_line.background": "#050505",
        "editor.highlighted_line.background": "#050505",
        "editor.indent_guide": "#9ba29030",
        "editor.indent_guide_active": "#b09573",
        "editor.wrap_guide": "#2d3640",
        "editor.active_wrap_guide": "#b09573",
        "editor.invisible": "#e3e4e229",
        "editor.document_highlight.read_background": "#2f2f37",
        "editor.document_highlight.write_background": "#315268",
        "editor.document_highlight.bracket_background": "#b0957333",

        "element.background": "#050505",
        "element.hover": "#2d3640",
        "element.active": "#315268",
        "element.selected": "#2d3640",
        "element.disabled": "#050505",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#05050540",
        "ghost_element.active": "#2d364080",
        "ghost_element.selected": "#2d364060",
        "ghost_element.disabled": "#050505",

        "drop_target.background": "#315268aa",

        "text": "#a08563",
        "text.muted": "#686868",
        "text.placeholder": "#5b4d3c",
        "text.disabled": "#5b4d3c",
        "text.accent": "#d8a51d",

        "icon": "#a08563",
        "icon.muted": "#686868",
        "icon.disabled": "#5b4d3c",
        "icon.placeholder": "#5b4d3c",
        "icon.accent": "#d8a51d",


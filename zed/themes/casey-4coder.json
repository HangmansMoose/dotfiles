          {
            "cursor": "#00ee00",
            "background": "#00ee0040",
            "selection": "#315268"
          },
          {
            "cursor": "#ee7700",
            "background": "#ee770040",
            "selection": "#315268aa"
          }
        ],

        "accents": [
          "#ac7b0b",
          "#cc5735",
          "#d8a51d",
          "#6b8e23",
          "#478980",
          "#b09573"
        ],

        "syntax": {
          "keyword": {
            "color": "#ac7b0b",
            "font_weight": null
          },
          "keyword.operator": {
            "color": "#907553"
          },
          "operator": {
            "color": "#907553"
          },
          "punctuation": {
            "color": "#907553"
          },
          "punctuation.bracket": {
            "color": "#907553"
          },
          "punctuation.delimiter": {
            "color": "#907553"
          },
          "punctuation.special": {
            "color": "#907553"
          },
          "function": {
            "color": "#cc5735"
          },
          "function.builtin": {
            "color": "#cc5735"
          },
          "function.call": {
            "color": "#cc5735"
          },
          "function.method": {
            "color": "#cc5735"
          },
          "function.method.call": {
            "color": "#cc5735"
          },
          "type": {
            "color": "#d8a51d"
          },
          "type.builtin": {
            "color": "#ac7b0b"
          },
          "constructor": {
            "color": "#d8a51d"
          },
          "variable": {
            "color": "#a08563"
          },
          "variable.builtin": {
            "color": "#ac7b0b"
          },
          "variable.special": {
            "color": "#ac7b0b"
          },
          "property": {
            "color": "#d8a51d"
          },
          "attribute": {
            "color": "#b09573"
          },
          "constant": {
            "color": "#6b8e23"
          },
          "constant.builtin": {
            "color": "#6b8e23"
          },
          "number": {
            "color": "#6b8e23"
          },
          "boolean": {
            "color": "#6b8e23"
          },
          "string": {
            "color": "#6b8e23"
          },
          "string.escape": {
            "color": "#6b8e23"
          },
          "string.regex": {
            "color": "#6b8e23"
          },
          "string.special": {
            "color": "#6b8e23"
          },
          "character": {
            "color": "#6b8e23"
          },
          "comment": {
            "color": "#686868",
            "font_style": "normal"
          },
          "comment.doc": {
            "color": "#686868"
          },
          "preproc": {
            "color": "#478980"
          },
          "macro": {
            "color": "#478980"
          },
          "label": {
            "color": "#d8a51d"
          },
          "tag": {
            "color": "#ac7b0b"
          },
          "tag.attribute": {
            "color": "#b09573"
          },
          "embedded": {
            "color": "#ff0000"
          },
          "link_uri": {
            "color": "#6b8e23"
          },
          "link_text": {
            "color": "#ac7b0b"
          }
        }

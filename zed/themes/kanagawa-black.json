{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Kanagawa Black",
  "author": "converted",
  "themes": [
    {
      "name": "Kanagawa Black",
      "appearance": "dark",
      "style": {
        "background": "#0d0c0c",
        "surface.background": "#121212",
        "panel.background": "#121212",
        "element.background": "#161616",
        "element.hover": "#1f1f1f",
        "element.active": "#2a2a2a",
        "element.selected": "#2a2a37",

        "border": "#2a2a2a",
        "border.variant": "#1c1c1c",
        "border.focused": "#54546d",
        "border.selected": "#54546d",
        "border.disabled": "#121212",

        "text": "#c5c9c5",
        "text.muted": "#8a8a8a",
        "text.placeholder": "#6b6b6b",
        "text.disabled": "#54546d",
        "text.accent": "#957fb8",

        "icon": "#c5c9c5",
        "icon.accent": "#7e9cd8",

        "editor.background": "#0d0c0c",
        "editor.foreground": "#c5c9c5",
        "editor.gutter.background": "#0d0c0c",
        "editor.line_number": "#54546d",
        "editor.active_line_number": "#c8c093",
        "editor.active_line.background": "#1a1a1a",
        "editor.wrap_guide": "#2a2a2a",
        "editor.active_wrap_guide": "#54546d",
        "editor.document_highlight.read_background": "#2d2a2e",
        "editor.document_highlight.write_background": "#363646",

        "tab_bar.background": "#0d0c0c",
        "tab.inactive_background": "#0d0c0c",
        "tab.active_background": "#161616",

        "title_bar.background": "#0d0c0c",
        "title_bar.inactive_background": "#0d0c0c",

        "status_bar.background": "#0d0c0c",

        "scrollbar.thumb.background": "#2a2a2a",
        "scrollbar.thumb.hover_background": "#3a3a3a",
        "scrollbar.track.background": "#0d0c0c",

        "terminal.background": "#0d0c0c",
        "terminal.foreground": "#c5c9c5",

        "terminal.ansi.black": "#0d0c0c",
        "terminal.ansi.red": "#e46876",
        "terminal.ansi.green": "#98bb6c",
        "terminal.ansi.yellow": "#dca561",
        "terminal.ansi.blue": "#7e9cd8",
        "terminal.ansi.magenta": "#957fb8",
        "terminal.ansi.cyan": "#7fb4ca",
        "terminal.ansi.white": "#c5c9c5",

        "terminal.ansi.bright_black": "#54546d",
        "terminal.ansi.bright_red": "#ec818c",
        "terminal.ansi.bright_green": "#a6c880",
        "terminal.ansi.bright_yellow": "#e6c384",
        "terminal.ansi.bright_blue": "#8ba4f6",
        "terminal.ansi.bright_magenta": "#a78fd2",
        "terminal.ansi.bright_cyan": "#8fd4ea",
        "terminal.ansi.bright_white": "#ffffff",

        "error": "#e46876",
        "warning": "#dca561",
        "success": "#98bb6c",
        "info": "#7fb4ca",

        "background.appearance": "opaque",

        "syntax": {
          "comment": {
            "color": "#727169",
            "font_style": "oblique"
          },
          "comment.doc": {
            "color": "#7a796f",
            "font_style": "oblique"
          },
          "string": {
            "color": "#98bb6c"
          },
          "string.escape": {
            "color": "#7fb4ca"
          },
          "string.regex": {
            "color": "#a3d4fb"
          },
          "number": {
            "color": "#d27e99"
          },
          "boolean": {
            "color": "#d27e99"
          },
          "constant": {
            "color": "#d27e99"
          },
          "variable": {
            "color": "#c5c9c5"
          },
          "variable.special": {
            "color": "#e46876"
          },
          "property": {
            "color": "#7e9cd8"
          },
          "parameter": {
            "color": "#c8c093"
          },
          "function": {
            "color": "#7fb4ca"
          },
          "function.method": {
            "color": "#7fb4ca"
          },
          "function.special.definition": {
            "color": "#98bb6c"
          },
          "keyword": {
            "color": "#957fb8"
          },
          "keyword.control": {
            "color": "#957fb8"
          },
          "operator": {
            "color": "#c5c9c5"
          },
          "type": {
            "color": "#7e9cd8"
          },
          "type.builtin": {
            "color": "#7e9cd8"
          },
          "namespace": {
            "color": "#7e9cd8"
          },
          "attribute": {
            "color": "#e6c384"
          },
          "tag": {
            "color": "#e46876"
          },
          "punctuation": {
            "color": "#9e9e9e"
          },
          "punctuation.bracket": {
            "color": "#a0a0a0"
          },
          "markup.heading": {
            "color": "#7fb4ca",
            "font_weight": 700
          },
          "markup.bold": {
            "font_weight": 700
          },
          "markup.italic": {
            "font_style": "italic"
          },
          "markup.link": {
            "color": "#7e9cd8"
          }
        }
      }
    }
  ],
}

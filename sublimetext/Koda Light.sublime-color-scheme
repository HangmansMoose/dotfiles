{
    "name": "Koda Light",
    "author": "Sublime Text port of koda.nvim by oskarnurm (https://github.com/oskarnurm/koda.nvim)",
    "variables": {
        "bg": "#faf9f5",
        "fg": "#101010",
        "caret": "#101010",
        "line": "#ebebeb",
        "selection": "#ebebeb",
        "selection_border": "#cccccc",
        "inactive_selection": "#f2f1f0",
        "gutter": "#faf9f5",
        "gutter_fg": "#969ba5",
        "gutter_hl": "#b07700",
        "guide": "#cccccc",
        "active_guide": "#969ba5",
        "stack_guide": "#ebebeb",
        "find_bg": "#ebdfc4",
        "find_fg": "#b07700",
        "highlight": "#0253be",
        "accent": "#0253be",
        "misspelling": "#ca0043",
        "invisibles": "#cccccc",
        "bracket": "#b07700",
        "tag_outline": "#666666",
        "shadow": "#00000030",
        "popup_bg": "#faf9f5",
        "popup_border": "#000000",
        "popup_fg": "#101010",
        "comment": "#969ba5",
        "doc_comment": "#969ba5",
        "todo": "#0253be",
        "string": "#407f00",
        "string_alt": "#407f00",
        "escape": "#101010",
        "regexp": "#407f00",
        "string_punct": "#407f00",
        "number": "#b07700",
        "boolean": "#b07700",
        "constant": "#b07700",
        "constant_builtin": "#b07700",
        "variable": "#101010",
        "parameter": "#101010",
        "member": "#101010",
        "property": "#101010",
        "self": "#b07700",
        "function": "#000000",
        "function_builtin": "#000000",
        "method": "#000000",
        "macro": "#b07700",
        "namespace": "#101010",
        "label": "#666666",
        "decorator": "#666666",
        "keyword": "#666666",
        "keyword_control": "#666666",
        "keyword_import": "#666666",
        "keyword_operator": "#3d3d3d",
        "keyword_return": "#000000",
        "operator": "#3d3d3d",
        "storage": "#666666",
        "type": "#666666",
        "type_builtin": "#666666",
        "klass": "#666666",
        "interface": "#101010",
        "enum": "#666666",
        "enum_member": "#b07700",
        "punctuation": "#666666",
        "delimiter": "#666666",
        "accessor": "#666666",
        "brackets": "#101010",
        "tag": "#666666",
        "tag_attribute": "#666666",
        "tag_punct": "#666666",
        "markup_heading": "#000000",
        "markup_link": "#000000",
        "markup_url": "#0253be",
        "markup_raw": "#b07700",
        "markup_list": "#000000",
        "markup_quote": "#969ba5",
        "error": "#ca0043",
        "warning": "#b07700",
        "info": "#101010",
        "hint": "#0253be",
        "ok": "#407f00",
        "invalid_fg": "#ca0043",
        "deprecated": "#969ba5",
        "diff_add_fg": "#407f00",
        "diff_add_bg": "#d5e1c4",
        "diff_del_fg": "#ca0043",
        "diff_del_bg": "#f0c7d1",
        "diff_chg_fg": "#b07700",
        "diff_chg_bg": "#ebdfc4",
        "diff_text_bg": "#dcc593",
        "diff_header": "#969ba5",
        "line_diff_add": "#407f00",
        "line_diff_mod": "#b07700",
        "line_diff_del": "#ca0043"
    },
    "globals": {
        "background": "var(bg)",
        "foreground": "var(fg)",
        "caret": "var(caret)",
        "block_caret": "var(caret)",
        "line_highlight": "var(line)",
        "selection": "var(selection)",
        "selection_border": "var(selection_border)",
        "selection_border_width": "1",
        "selection_corner_style": "round",
        "inactive_selection": "var(inactive_selection)",
        "highlight": "var(highlight)",
        "find_highlight": "var(find_bg)",
        "find_highlight_foreground": "var(find_fg)",
        "misspelling": "var(misspelling)",
        "accent": "var(accent)",
        "guide": "var(guide)",
        "active_guide": "var(active_guide)",
        "stack_guide": "var(stack_guide)",
        "gutter": "var(gutter)",
        "gutter_foreground": "var(gutter_fg)",
        "gutter_foreground_highlight": "var(gutter_hl)",
        "fold_marker": "var(accent)",
        "minimap_border": "var(selection_border)",
        "brackets_options": "underline",
        "brackets_foreground": "var(bracket)",
        "bracket_contents_options": "underline",
        "bracket_contents_foreground": "var(bracket)",
        "tags_options": "stippled_underline",
        "tags_foreground": "var(tag_outline)",
        "shadow": "#00000030",
        "shadow_width": "8",
        "line_diff_width": "3",
        "line_diff_added": "var(line_diff_add)",
        "line_diff_modified": "var(line_diff_mod)",
        "line_diff_deleted": "var(line_diff_del)",
        "popup_css": "html, body {\n    margin: 0;\n    padding: 0;\n    background-color: #faf9f5;\n    color: #101010;\n}\nbody {\n    padding: 0.5rem 0.6rem;\n}\na {\n    color: #0253be;\n    text-decoration: none;\n}\ncode, .code {\n    background-color: #ebebeb;\n    color: #101010;\n    padding: 0 0.2rem;\n}\ndiv.error, div.warning, div.info, div.success {\n    padding: 0.4rem;\n    margin: 0;\n}\ndiv.error { background-color: #faf9f5; color: #ca0043; }\ndiv.warning { background-color: #faf9f5; color: #b07700; }\ndiv.info { background-color: #faf9f5; color: #101010; }\ndiv.success { background-color: #faf9f5; color: #407f00; }\n"
    },
    "rules": [
        {
            "name": "Comment",
            "scope": "comment, punctuation.definition.comment",
            "foreground": "var(comment)"
        },
        {
            "name": "Documentation comment",
            "scope": "comment.block.documentation, comment.block.documentation punctuation.definition.comment",
            "foreground": "var(doc_comment)"
        },
        {
            "name": "Codetag / TODO",
            "scope": "keyword.codetag.notation, comment keyword.codetag, meta.annotation.codetag",
            "foreground": "var(todo)",
            "font_style": "bold"
        },
        {
            "name": "String",
            "scope": "string",
            "foreground": "var(string)"
        },
        {
            "name": "String punctuation",
            "scope": "punctuation.definition.string.begin, punctuation.definition.string.end",
            "foreground": "var(string_punct)"
        },
        {
            "name": "Character literal",
            "scope": "constant.character, string.quoted.single.char, constant.other.character",
            "foreground": "var(string_alt)"
        },
        {
            "name": "Escape sequence",
            "scope": "constant.character.escape, constant.other.placeholder, constant.other.escape",
            "foreground": "var(escape)"
        },
        {
            "name": "Escape punctuation",
            "scope": "constant.character.escape punctuation.definition.escape",
            "foreground": "var(escape)"
        },
        {
            "name": "Regular expression",
            "scope": "string.regexp",
            "foreground": "var(regexp)"
        },
        {
            "name": "Regex operator",
            "scope": "string.regexp keyword.operator, string.regexp keyword.other",
            "foreground": "var(escape)"
        },
        {
            "name": "Interpolation punctuation",
            "scope": "punctuation.section.interpolation, punctuation.definition.interpolation",
            "foreground": "var(escape)"
        },
        {
            "name": "Docstring",
            "scope": "string.quoted.docstring, string.unquoted.documentation",
            "foreground": "var(doc_comment)"
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "foreground": "var(number)"
        },
        {
            "name": "Number suffix",
            "scope": "constant.numeric punctuation, constant.numeric.suffix",
            "foreground": "var(number)"
        },
        {
            "name": "Boolean / language constant",
            "scope": "constant.language",
            "foreground": "var(boolean)"
        },
        {
            "name": "Other constant",
            "scope": "constant.other",
            "foreground": "var(constant)"
        },
        {
            "name": "Constant name",
            "scope": "entity.name.constant",
            "foreground": "var(constant)"
        },
        {
            "name": "Enum member",
            "scope": "constant.other.enum, variable.other.enummember, meta.enum variable.other.constant",
            "foreground": "var(enum_member)"
        },
        {
            "name": "Variable",
            "scope": "variable, variable.other, variable.other.readwrite",
            "foreground": "var(variable)"
        },
        {
            "name": "Member / property",
            "scope": "variable.other.member, variable.other.property, meta.property-name, support.other.variable",
            "foreground": "var(member)"
        },
        {
            "name": "Object key",
            "scope": "meta.mapping.key string, meta.object-literal.key, meta.mapping.key",
            "foreground": "var(property)"
        },
        {
            "name": "Constant variable",
            "scope": "variable.other.constant",
            "foreground": "var(constant)"
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter, meta.function.parameters variable",
            "foreground": "var(parameter)"
        },
        {
            "name": "Builtin variable (this/self)",
            "scope": "variable.language, variable.other.self, variable.parameter.function.language.special.self",
            "foreground": "var(self)"
        },
        {
            "name": "Namespace / module",
            "scope": "entity.name.namespace, entity.name.module, meta.namespace entity.name, support.other.namespace, variable.other.namespace",
            "foreground": "var(namespace)"
        },
        {
            "name": "Function definition",
            "scope": "entity.name.function, meta.function entity.name.function",
            "foreground": "var(function)",
            "font_style": "bold"
        },
        {
            "name": "Function call",
            "scope": "variable.function, meta.function-call variable.function, meta.function-call.identifier",
            "foreground": "var(function)",
            "font_style": "bold"
        },
        {
            "name": "Method",
            "scope": "entity.name.function.member, variable.function.member, meta.method entity.name.function",
            "foreground": "var(method)",
            "font_style": "bold"
        },
        {
            "name": "Builtin function",
            "scope": "support.function, support.function.builtin",
            "foreground": "var(function_builtin)",
            "font_style": "bold"
        },
        {
            "name": "Macro",
            "scope": "variable.macro, entity.name.macro, support.macro, entity.name.function.macro, meta.macro entity.name.function",
            "foreground": "var(macro)"
        },
        {
            "name": "Constructor",
            "scope": "entity.name.function.constructor, entity.name.function.new",
            "foreground": "var(klass)"
        },
        {
            "name": "Decorator / annotation",
            "scope": "variable.annotation, meta.annotation variable.annotation, meta.annotation.identifier, punctuation.definition.annotation, meta.decorator",
            "foreground": "var(decorator)"
        },
        {
            "name": "Label",
            "scope": "entity.name.label, constant.other.label",
            "foreground": "var(label)"
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "foreground": "var(keyword)"
        },
        {
            "name": "Control keyword",
            "scope": "keyword.control",
            "foreground": "var(keyword_control)"
        },
        {
            "name": "Return / yield",
            "scope": "keyword.control.flow.return, keyword.control.return, keyword.control.flow.yield",
            "foreground": "var(keyword_return)"
        },
        {
            "name": "Import / export",
            "scope": "keyword.control.import, keyword.control.export, keyword.control.at-rule.import, keyword.other.import",
            "foreground": "var(keyword_import)"
        },
        {
            "name": "Keyword operator",
            "scope": "keyword.operator.word, keyword.operator.logical, keyword.operator.new, keyword.operator.expression, keyword.operator.alignas",
            "foreground": "var(keyword_operator)"
        },
        {
            "name": "Operator",
            "scope": "keyword.operator, punctuation.separator.key-value",
            "foreground": "var(operator)"
        },
        {
            "name": "Storage / declaration",
            "scope": "storage, storage.type, keyword.declaration",
            "foreground": "var(storage)"
        },
        {
            "name": "Storage modifier",
            "scope": "storage.modifier, keyword.other.modifier",
            "foreground": "var(storage)"
        },
        {
            "name": "Preprocessor",
            "scope": "keyword.control.directive, meta.preprocessor, keyword.control.import.define, keyword.other.preprocessor",
            "foreground": "var(keyword_import)"
        },
        {
            "name": "Type",
            "scope": "entity.name.type, entity.name.struct, entity.name.union, storage.type.class, meta.type entity.name",
            "foreground": "var(type)"
        },
        {
            "name": "Class",
            "scope": "entity.name.class, support.class, meta.class entity.name.class",
            "foreground": "var(klass)"
        },
        {
            "name": "Interface / trait",
            "scope": "entity.name.interface, entity.name.trait, entity.other.inherited-class",
            "foreground": "var(interface)"
        },
        {
            "name": "Enum",
            "scope": "entity.name.enum, variable.other.enum",
            "foreground": "var(enum)"
        },
        {
            "name": "Builtin type",
            "scope": "support.type, storage.type.primitive, support.type.builtin, storage.type.builtin",
            "foreground": "var(type_builtin)"
        },
        {
            "name": "Type parameter",
            "scope": "variable.parameter.type, entity.name.type.parameter, meta.generic variable.parameter",
            "foreground": "var(type)"
        },
        {
            "name": "Type definition",
            "scope": "entity.name.type.typedef, entity.name.type.alias",
            "foreground": "var(type)"
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "foreground": "var(punctuation)"
        },
        {
            "name": "Separator / terminator",
            "scope": "punctuation.separator, punctuation.terminator",
            "foreground": "var(delimiter)"
        },
        {
            "name": "Accessor",
            "scope": "punctuation.accessor",
            "foreground": "var(accessor)"
        },
        {
            "name": "Brackets",
            "scope": "punctuation.section.block, punctuation.section.braces, punctuation.section.brackets, punctuation.section.parens, punctuation.section.group, punctuation.section.arguments, punctuation.section.sequence, punctuation.section.mapping, meta.brace",
            "foreground": "var(brackets)"
        },
        {
            "name": "Section keys",
            "scope": "punctuation.definition.keyword, punctuation.definition.variable",
            "foreground": "var(punctuation)"
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "foreground": "var(tag)"
        },
        {
            "name": "Tag punctuation",
            "scope": "punctuation.definition.tag, punctuation.definition.tag.begin, punctuation.definition.tag.end",
            "foreground": "var(tag_punct)"
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "foreground": "var(tag_attribute)"
        },
        {
            "name": "Attribute value",
            "scope": "meta.tag string.quoted, meta.attribute-with-value string",
            "foreground": "var(string)"
        },
        {
            "name": "CSS selector",
            "scope": "entity.other.pseudo-class, entity.other.pseudo-element",
            "foreground": "var(keyword)"
        },
        {
            "name": "CSS property",
            "scope": "support.type.property-name, meta.property-name support.type",
            "foreground": "var(property)"
        },
        {
            "name": "CSS value",
            "scope": "support.constant.property-value, meta.property-value support.constant",
            "foreground": "var(constant)"
        },
        {
            "name": "CSS unit",
            "scope": "keyword.other.unit",
            "foreground": "var(number)"
        },
        {
            "name": "YAML anchor",
            "scope": "entity.name.other.anchor, variable.other.alias, punctuation.definition.anchor, punctuation.definition.alias",
            "foreground": "var(constant)"
        },
        {
            "name": "JSON key",
            "scope": "source.json meta.mapping.key string",
            "foreground": "var(property)"
        },
        {
            "name": "Markup heading",
            "scope": "markup.heading, markup.heading entity.name, entity.name.section",
            "foreground": "var(markup_heading)",
            "font_style": "bold"
        },
        {
            "name": "Markup heading punctuation",
            "scope": "punctuation.definition.heading",
            "foreground": "var(markup_heading)"
        },
        {
            "name": "Markup bold",
            "scope": "markup.bold, markup.bold punctuation.definition",
            "foreground": "var(markup_list)",
            "font_style": "bold"
        },
        {
            "name": "Markup italic",
            "scope": "markup.italic, markup.italic punctuation.definition",
            "foreground": "var(markup_list)",
            "font_style": "italic"
        },
        {
            "name": "Markup underline",
            "scope": "markup.underline",
            "font_style": "underline"
        },
        {
            "name": "Markup strikethrough",
            "scope": "markup.strikethrough",
            "foreground": "var(deprecated)"
        },
        {
            "name": "Markup link",
            "scope": "markup.underline.link, markup.link, meta.link",
            "foreground": "var(markup_url)",
            "font_style": "underline"
        },
        {
            "name": "Markup link text",
            "scope": "meta.link.inline string.other.link, string.other.link.title, markup.link.text",
            "foreground": "var(markup_link)"
        },
        {
            "name": "Markup raw / code",
            "scope": "markup.raw, markup.raw.inline, markup.raw.block, markup.raw.code-fence",
            "foreground": "var(markup_raw)"
        },
        {
            "name": "Markup list bullet",
            "scope": "markup.list punctuation.definition, punctuation.definition.list_item, markup.list.numbered.bullet",
            "foreground": "var(markup_list)"
        },
        {
            "name": "Markup quote",
            "scope": "markup.quote, markup.quote punctuation.definition",
            "foreground": "var(markup_quote)",
            "font_style": "italic"
        },
        {
            "name": "Markup separator",
            "scope": "meta.separator, punctuation.definition.thematic-break",
            "foreground": "var(markup_quote)"
        },
        {
            "name": "Diff header",
            "scope": "meta.diff, meta.diff.header, meta.diff.index, meta.diff.range",
            "foreground": "var(diff_header)"
        },
        {
            "name": "Diff inserted",
            "scope": "markup.inserted, meta.diff.header.to-file",
            "background": "var(diff_add_bg)",
            "foreground": "var(diff_add_fg)"
        },
        {
            "name": "Diff deleted",
            "scope": "markup.deleted, meta.diff.header.from-file",
            "background": "var(diff_del_bg)",
            "foreground": "var(diff_del_fg)"
        },
        {
            "name": "Diff changed",
            "scope": "markup.changed",
            "background": "var(diff_chg_bg)",
            "foreground": "var(diff_chg_fg)"
        },
        {
            "name": "Git conflict marker",
            "scope": "meta.conflict, punctuation.section.block.conflict",
            "background": "var(diff_text_bg)",
            "foreground": "var(diff_chg_fg)"
        },
        {
            "name": "Invalid",
            "scope": "invalid, invalid.illegal",
            "foreground": "var(invalid_fg)"
        },
        {
            "name": "Deprecated",
            "scope": "invalid.deprecated",
            "foreground": "var(deprecated)",
            "font_style": "italic"
        },
        {
            "name": "Shell built-in",
            "scope": "support.function.builtin.shell, meta.function-call.identifier.shell",
            "foreground": "var(function_builtin)"
        },
        {
            "name": "LSP diagnostic error",
            "scope": "markup.error, markup.error.lsp",
            "foreground": "var(error)",
            "font_style": "squiggly_underline"
        },
        {
            "name": "LSP diagnostic warning",
            "scope": "markup.warning, markup.warning.lsp",
            "foreground": "var(warning)",
            "font_style": "squiggly_underline"
        },
        {
            "name": "LSP diagnostic info",
            "scope": "markup.info, markup.info.lsp",
            "foreground": "var(info)",
            "font_style": "stippled_underline"
        },
        {
            "name": "LSP diagnostic hint",
            "scope": "markup.info.hint, markup.info.hint.lsp",
            "foreground": "var(hint)",
            "font_style": "stippled_underline"
        },
        {
            "name": "LSP unnecessary code",
            "scope": "markup.unnecessary",
            "background": "color(var(bg) alpha(0.98))",
            "foreground": "var(deprecated)"
        },
        {
            "name": "LSP deprecated code",
            "scope": "markup.deprecated",
            "foreground": "var(deprecated)",
            "font_style": "stippled_underline"
        },
        {
            "name": "LSP document highlight (text)",
            "scope": "markup.highlight.text",
            "background": "var(selection)"
        },
        {
            "name": "LSP document highlight (read)",
            "scope": "markup.highlight.read",
            "background": "var(selection)"
        },
        {
            "name": "LSP document highlight (write)",
            "scope": "markup.highlight.write",
            "background": "var(diff_chg_bg)"
        },
        {
            "name": "LSP hover highlight",
            "scope": "markup.highlight.hover",
            "background": "var(selection)"
        },
        {
            "name": "LSP signature help",
            "scope": "meta.signature-help",
            "background": "var(popup_bg)",
            "foreground": "var(fg)"
        },
        {
            "name": "LSP signature help parameter",
            "scope": "meta.signature-help.parameter, meta.signature-help meta.function.parameters",
            "foreground": "var(parameter)"
        },
        {
            "name": "LSP active parameter",
            "scope": "variable.parameter.sighelp.active",
            "foreground": "var(accent)",
            "font_style": "bold"
        },
        {
            "name": "LSP code action accent",
            "scope": "markup.accent.codeaction",
            "foreground": "var(hint)"
        },
        {
            "name": "LSP code lens accent",
            "scope": "markup.accent.codelens",
            "foreground": "var(ok)"
        },
        {
            "name": "LSP inlay hint",
            "scope": "markup.inlayhint, meta.inlay-hint",
            "foreground": "var(deprecated)"
        },
        {
            "name": "Semantic token (enables LSP semantic highlighting)",
            "scope": "meta.semantic-token",
            "background": "color(var(bg) alpha(0.98))"
        },
        {
            "name": "Semantic: namespace",
            "scope": "meta.semantic-token.namespace",
            "foreground": "var(namespace)"
        },
        {
            "name": "Semantic: type",
            "scope": "meta.semantic-token.type",
            "foreground": "var(type)"
        },
        {
            "name": "Semantic: class",
            "scope": "meta.semantic-token.class",
            "foreground": "var(klass)"
        },
        {
            "name": "Semantic: enum",
            "scope": "meta.semantic-token.enum",
            "foreground": "var(enum)"
        },
        {
            "name": "Semantic: interface",
            "scope": "meta.semantic-token.interface",
            "foreground": "var(interface)"
        },
        {
            "name": "Semantic: struct",
            "scope": "meta.semantic-token.struct",
            "foreground": "var(type)"
        },
        {
            "name": "Semantic: typeparameter",
            "scope": "meta.semantic-token.typeparameter",
            "foreground": "var(type)"
        },
        {
            "name": "Semantic: parameter",
            "scope": "meta.semantic-token.parameter",
            "foreground": "var(parameter)"
        },
        {

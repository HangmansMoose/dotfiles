      "name": "Doc markup",
      "scope": "comment.block.documentation keyword, comment.block.documentation storage.type, comment.block.documentation entity.name.tag, comment.block.documentation variable.parameter, entity.name.tag.documentation",
      "foreground": "var(docmarkup)"
    },
    {
      "name": "String",
      "scope": "string, constant.character, punctuation.definition.string",
      "foreground": "var(string)"
    },
    {
      "name": "Escape",
      "scope": "constant.character.escape, constant.other.placeholder, constant.character.format",
      "foreground": "var(keybind)"
    },
    {
      "name": "Regexp",
      "scope": "string.regexp",
      "foreground": "var(string)"
    },
    {
      "name": "Regexp construct",
      "scope": "string.regexp keyword, string.regexp constant.other.character-class, string.regexp punctuation.definition.group, string.regexp punctuation.definition.character-class, string.regexp keyword.operator",
      "foreground": "var(rx_construct)"
    },
    {
      "name": "Regexp backslash",
      "scope": "string.regexp constant.character.escape, string.regexp punctuation.definition.backslash",
      "foreground": "var(rx_backslash)"
    },
    {
      "name": "Keyword",
      "scope": "keyword, storage.modifier, keyword.declaration, storage.type.function, storage.type.class, storage.type.struct, storage.type.enum, storage.type.trait, storage.type.impl, storage.type.namespace, storage.type.module",
      "foreground": "var(keyword)"
    },
    {
      "name": "Word operator",
      "scope": "keyword.operator.word, keyword.operator.logical.python, keyword.operator.new, keyword.operator.expression",
      "foreground": "var(keyword)"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "var(operator)"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "var(punctuation)"
    },
    {
      "name": "Bracket",
      "scope": "punctuation.section, punctuation.definition.group, punctuation.definition.block, punctuation.section.brackets, punctuation.section.parens, punctuation.section.braces",
      "foreground": "var(bracket)"
    },
    {
      "name": "Delimiter",
      "scope": "punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "var(delimiter)"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "var(number)"
    },
    {
      "name": "Constant",
      "scope": "constant.language, constant.other, variable.other.constant, entity.name.constant, support.constant, variable.other.enummember",
      "foreground": "var(constant)"
    },
    {
      "name": "Builtin",
      "scope": "support.function, support.macro, variable.language, support.variable, support.module, entity.name.function.preprocessor",
      "foreground": "var(builtin)"
    },
    {
      "name": "Function definition",
      "scope": "entity.name.function, entity.name.method, meta.definition.method entity.name, entity.name.macro, entity.name.label",
      "foreground": "var(fnname)"
    },
    {
      "name": "Function call",
      "scope": "variable.function, meta.function-call.identifier, meta.function-call variable.function, meta.method-call variable.function, support.function.call",
      "foreground": "var(fnname_call)"
    },
    {
      "name": "Type",
      "scope": "storage.type, entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, entity.name.trait, entity.name.interface, entity.name.impl, entity.name.namespace, entity.other.inherited-class, support.type, support.class, entity.name.type.module, meta.annotation, meta.decorator, entity.name.function.decorator, punctuation.definition.annotation, punctuation.definition.decorator",
      "foreground": "var(type)"
    },
    {
      "name": "Variable definition",
      "scope": "variable.parameter, entity.name.variable, variable.other.readwrite.assignment, meta.binding.name, variable.declaration",
      "foreground": "var(variable)"
    },
    {
      "name": "Property",
      "scope": "variable.other.member, variable.other.property, variable.other.object.property, meta.property-name, support.type.property-name, meta.mapping.key string, meta.object-literal.key, entity.name.tag.yaml, entity.name.key, keyword.other.definition.ini, entity.name.section.toml",
      "foreground": "var(property)"
    },
    {
      "name": "Preprocessor",
      "scope": "meta.preprocessor, keyword.control.directive, keyword.control.import.c, keyword.control.import.c++, punctuation.definition.directive, punctuation.definition.preprocessor, keyword.other.preprocessor, meta.attribute, punctuation.definition.attribute",
      "foreground": "var(preprocessor)"
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "foreground": "var(fnname)"
    },
    {
      "name": "Tag punctuation",
      "scope": "punctuation.definition.tag",
      "foreground": "var(fg_dim)"
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "var(variable)"
    },
    {
      "name": "CSS selector",
      "scope": "entity.other.attribute-name.class.css, entity.other.attribute-name.id.css, entity.other.pseudo-class, entity.other.pseudo-element, entity.name.tag.css",
      "foreground": "var(fnname)"

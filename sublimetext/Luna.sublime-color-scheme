{
    // Luna — a near-black Sublime Text color scheme built on greys, with
    // four accent hues and nothing else.
    // Ported from the Neovim colorscheme luna.nvim by WTFox
    // (https://github.com/WTFox/luna.nvim).
    //
    // Install: copy to Packages/User/Luna.sublime-color-scheme, then pick
    // "Luna" from Preferences > Color Scheme.
    "name": "Luna",
    "author": "Ported from luna.nvim by WTFox",

    "variables": {
        "bg":          "#060606",
        "bg_alt":      "#1c1c1c",
        "bg_soft":     "#1f1f1f",
        "bg_plum":     "#302028",
        "bg_delete":   "#40000a",
        "surface":     "#333333",
        "selection":   "#384048",
        "border":      "#404040",
        "float_bg":    "#403c41",

        "grey_warm":   "#605958",
        "comment":     "#7c7c7c",
        "grey":        "#888888",
        "grey_mid":    "#989898",
        "grey_light":  "#a8a8a8",
        "grey_pale":   "#b8b8b8",
        "silver":      "#c7c7c7",
        "fg":          "#e4e4e8",
        "fg_bright":   "#f0f0f0",
        "cream":       "#f0e0d6",

        "keyword":     "#e19067",
        "func":        "#75a1c7",
        "type":        "#c4a8d6",
        "string":      "#9eb38e",
        "signal":      "#c2916a",

        "error":       "#e08585",
        "warning":     "#d9a35a",
        "info":        "#8c9cb8",
        "hint":        "#b09080",
        "ok":          "#6fbe80",

        "line_nr":       "#2f2b2b",
        "cursor_line_bg":"#212121"
    },

    "globals": {
        "background": "var(bg)",
        "foreground": "var(fg)",
        "caret": "#33FF33",
        "block_caret": "#33ff3388",
        "invisibles": "var(grey_warm)",
        "line_highlight": "var(cursor_line_bg)",
        "selection": "var(selection)",
        "selection_border": "var(border)",
        "inactive_selection": "color(var(selection) alpha(0.5))",
        "misspelling": "var(error)",
        "fold_marker": "var(signal)",
        "gutter": "var(bg)",
        "gutter_foreground": "var(line_nr)",
        "line_number": "var(line_nr)",
        "selection_corner_style": "round",
        "highlight": "var(signal)",
        "find_highlight": "var(bg_plum)",
        "find_highlight_foreground": "var(fg_bright)",
        "brackets_options": "underline",
        "brackets_foreground": "var(grey_light)",
        "bracket_contents_options": "underline",
        "bracket_contents_foreground": "var(grey_light)",
        "tags_options": "stippled_underline",
        "shadow": "color(black alpha(0.4))",
        "popup_css": "background-color: color(var(bg_soft));",
        "phantom_css": "background-color: color(var(bg_soft));"
    },

    "rules": [
        {
            "name": "Comment",
            "scope": "comment, punctuation.definition.comment",
            "foreground": "var(comment)",
            "font_style": "italic"
        },
        {
            "name": "String",
            "scope": "string, string.quoted, string.unquoted, markup.raw, markup.inline.raw",
            "foreground": "var(string)"
        },
        {
            "name": "String escape / regexp",
            "scope": "constant.character.escape, string.regexp",
            "foreground": "var(signal)"
        },
        {
            "name": "Keyword / storage / control",
            "scope": "keyword, keyword.control, keyword.operator.word, storage, storage.type, storage.modifier",
            "foreground": "var(keyword)"
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "foreground": "var(grey_light)"
        },
        {
            "name": "Number / language constant",
            "scope": "constant.numeric, constant.language, constant.language.boolean, variable.language.this",
            "foreground": "var(keyword)"
        },
        {
            "name": "Other constants",
            "scope": "constant.other, constant.other.color, support.constant, variable.other.enummember",
            "foreground": "var(type)"
        },
        {
            "name": "Import / include",
            "scope": "keyword.control.import, keyword.control.import.include, meta.import, keyword.other.import",
            "foreground": "var(keyword)",
            "font_style": "italic"
        },
        {
            "name": "Function / method",
            "scope": "entity.name.function, support.function, meta.function-call, variable.function, meta.function-call.generic",
            "foreground": "var(func)"
        },
        {
            "name": "Function macro / preprocessor",
            "scope": "entity.name.function.preprocessor, meta.preprocessor, support.function.macro",
            "foreground": "var(keyword)",
            "font_style": "bold"
        },
        {
            "name": "Type / class / trait / tag",
            "scope": "entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, entity.name.trait, entity.other.inherited-class, support.type, support.class, entity.name.tag, entity.name.tag.yaml, meta.jsx.children entity.name.tag",
            "foreground": "var(type)"
        },
        {
            "name": "Namespace",
            "scope": "entity.name.namespace, entity.name.module",
            "foreground": "var(grey_light)"
        },
        {
            "name": "Variable",
            "scope": "variable, variable.other.readwrite, meta.definition.variable",
            "foreground": "var(fg)"
        },
        {
            "name": "Object / struct property",
            "scope": "variable.other.property, variable.other.object.property, meta.object-literal.key, support.type.property-name",
            "foreground": "var(grey_pale)"
        },
        {
            "name": "Function parameter",
            "scope": "variable.parameter",
            "foreground": "var(fg)"
        },
        {
            "name": "Attribute / JSX prop",
            "scope": "entity.other.attribute-name",
            "foreground": "var(signal)"
        },
        {
            "name": "Punctuation",
            "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator, punctuation.definition.tag",
            "foreground": "var(grey_light)"
        },
        {
            "name": "Punctuation separator (dim)",
            "scope": "punctuation.separator.continuation, punctuation.accessor",
            "foreground": "var(grey_mid)"
        },
        {
            "name": "Markup heading",
            "scope": "markup.heading, entity.name.section",
            "foreground": "var(keyword)",
            "font_style": "bold"
        },
        {
            "name": "Markup bold",
            "scope": "markup.bold",
            "foreground": "var(cream)",
            "font_style": "bold"
        },
        {
            "name": "Markup italic",
            "scope": "markup.italic",
            "foreground": "var(cream)",
            "font_style": "italic"
        },
        {
            "name": "Markup link",
            "scope": "markup.underline.link, string.other.link, markup.link",
            "foreground": "var(func)",
            "font_style": "underline"
        },
        {
            "name": "Markup quote",
            "scope": "markup.quote",
            "foreground": "var(grey_light)",
            "font_style": "italic"
        },
        {
            "name": "Markup list",
            "scope": "markup.list, punctuation.definition.list_item",
            "foreground": "var(info)"
        },
        {
            "name": "Markup raw / inline code",
            "scope": "markup.raw.inline",
            "foreground": "var(signal)"
        },
        {
            "name": "Diff inserted",
            "scope": "markup.inserted",
            "foreground": "var(ok)"
        },
        {
            "name": "Diff deleted",
            "scope": "markup.deleted",
            "foreground": "var(error)"
        },
        {
            "name": "Diff changed",
            "scope": "markup.changed",
            "foreground": "var(signal)"
        },
        {
            "name": "Diagnostic error",
            "scope": "region.redish, message.error",
            "foreground": "var(error)"
        },
        {
            "name": "Diagnostic warning",
            "scope": "region.orangish",
            "foreground": "var(warning)"
        },
        {
            "name": "Diagnostic info / hint",
            "scope": "region.bluish, region.purplish",
            "foreground": "var(info)"
        },
        {
            "name": "Invalid",
            "scope": "invalid, invalid.illegal",
            "foreground": "var(fg)",
            "background": "var(error)"
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "foreground": "var(bg)",
            "background": "var(signal)"
        }
    ]
}

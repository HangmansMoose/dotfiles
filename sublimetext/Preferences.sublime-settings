{
	"ignored_packages":[
		"Vintage",
	],

	// Performance — disable redundant built-in indexer
    // when LSP is handling completions
    "index_files": true,
    "show_definitions": true,

    // UI
    "line_padding_top": -1,
    "line_padding_bottom": 0,
    "highlight_line": true,
    "caret_style": "solid",
    "caret_extra_bottom": 0,
    "caret_extra_top": 0,
    "caret_extra_width": 2,
	"gutter": true,
	"relative_line_numbers": true,
	"mini_diff": false,
	"inactive_sheet_dimming" : false,
	"preview_on_click" : false,
	"auto_hide_menu": false,
	"reveal_menu": true,
	"remember_full_screen": true,
	"remember_layout": true,
	"always_prompt_for_file_reload": true,
	"show_full_path": false,
	"show_git_status": false,
	"show_errors_inline": false,
	"neovintageous_build_version": 13200,
    "adaptive_dividers": true,
    //"file_tab_style": "angled",
    //"ui_scale": 1.15,
	"color_scheme": "Koda Moss.sublime-color-scheme",
	"theme": "Kujukuju.sublime-theme",
	//"font_face": "GoogleSansCode NF Medium",
	"font_face": "Monaspace Neon NF",
	"font_size": 13,
	"font_options": [
		//"no_bold",
		"no_italic",
		//"gdi",
		//"subpixel_antialias",
		//"no_liga",
		//"no_calt",
		//"no_clig"	
	],	
	"match_brackets": false,
	"indent_guide_options": [
		"draw_active"
	],

    // Editing
    "translate_tabs_to_spaces": false,
    "tab_size": 4,
    "ensure_newline_at_eof_on_save": true,
    "word_wrap": false,
    "show_spelling_errors": false,
    //"rulers": [100],

    // Sidebar & file tree
    "file_exclude_patterns": [
        "*.gd.uid",
	],
    "folder_exclude_patterns": [
        ".vs", ".cache",
	],

    // Build 4200+ — migrate off legacy Python 3.3 plugin host
    //"disable_plugin_host_3.3": true,

	"hardware_acceleration": "opengl",
	"hot_exit": false,
	"console_max_history_lines": 5000,
	//"syntax_detection_size_limit": 67108864,
	
	
	/*           Vintage            */
	"vintage_start_in_command_mode": false,
	"vintage_use_clipboard": true,
	"vintageous_enable_surround": true,

	"vintageous_enable_sublime": true,
	"vintageous_use_sys_clipboard": true,
	
	/*			UI 							*/
	
	"auto_complete_triggers":
	[
		{
			"characters": "<",
			"selector": "text.html, text.xml",
		},
		{
			"rhs_empty": true,
			"selector": "punctuation.accessor",
		},
		{
			"characters": "\\",
			"selector": "text.tex.latex",
		}
	],
	"file_icon_theme": "A File Icon.sublime-file-icons",
}

{
	"ignored_packages":[
		"Vintage",
	],

	// Performance — disable redundant built-in indexer
    // when LSP is handling completions
    "index_files": false,
    "show_definitions": false,

    // UI
    "line_padding_top": 1,
    "line_padding_bottom": 1,
    "highlight_line": true,
    "caret_style": "solid",
    "caret_extra_bottom": 0,
    "caret_extra_top": 0,
    "caret_extra_width": 2,

    // Editing
    "translate_tabs_to_spaces": false,
    "tab_size": 4,
    "ensure_newline_at_eof_on_save": true,
    "word_wrap": false,
    //"rulers": [100],

    // Sidebar & file tree
    "file_exclude_patterns": [
        "*.gd.uid",
	],
    "folder_exclude_patterns": [
        ".vs", ".cache",
	],

    // Build 4200+ — migrate off legacy Python 3.3 plugin host
    "disable_plugin_host_3.3": true,

	"hardware_acceleration": "opengl",
	"hot_exit": false,
	"console_max_history_lines": 10000,
	"syntax_detection_size_limit": 67108864,

	/*         Theme and Font        */
	"color_scheme": "Kanso Deep.sublime-color-scheme",
	"theme": "GitHub Dark Colorblind.sublime-theme",
	"font_face": "CaskaydiaMono NF",
	"font_size": 13,
	"font_options": [
		"no_bold",
		"no_italic"	
	],	
	"match_brackets": false,
	
	/*           Vintage            */
	"vintage_start_in_command_mode": true,
	"vintage_use_clipboard": true,
	"vintageous_enable_surround": true,

	"vintageous_enable_sublime": true,
	"vintageous_use_sys_clipboard": true,
	
	/*			UI 							*/
	"gutter": true,
	"relative_line_numbers": true,
	"mini_diff": false,
	/*"highlight_line": true,*/
	"inactive_sheet_dimming" : false,
	"preview_on_click" : false,
	"auto_hide_menu": true,
	"reveal_menu": true,
	"remember_full_screen": true,
	"remember_layout": true,
	"always_prompt_for_file_reload": true,
	"show_full_path": false,
	"show_git_status": false,
	"neovintageous_build_version": 13200,
	"auto_complete_triggers":
	[
		{
			"characters": "<",
			"selector": "text.html, text.xml",
		},
		{
			"rhs_empty": true,
			"selector": "punctuation.accessor",
		},
		{
			"characters": "\\",
			"selector": "text.tex.latex",
		}
	],
}

[editor.colors]
default_font_color = 0x90b080ff
whitespace = 0x6b845f29
carriage_return = 0xa72911ff
search_result = 0xbfd9b2aa
selection_color = 0x99ccff2e
token_match = 0x90b080aa
active_line_number = 0x90b080ff
inactive_line_number = 0x6b845fff

active_line_guide = 0x4900ff
highlight_line_copy = 0x32a852ff
highlight_line_edit = 0x3a90bbff
cursor_line_outline = 0x6b845f50
cursor_line_fill = 0x6b845f50

[editor.state]
show_line_numbers = true
auto_syntax_highlighting = true
auto_line_endings = true
render_whitespace = false
tabs_as_spaces = true
spellcheck_by_default = false
disable_line_highlight = false
html_copy_background = true
vim_mode = false
suppress_async_search = false
suppress_threaded_search = false
suppress_suggestions = false
modulate_color_glyphs = false
embold_vim_cursor = true

line_guides = true
relative_numbering = false
clear_find = false
return_accept_suggestion = true
show_line_rulers = false
enable_active_line_fill = false
enable_prim_cursor_fill = false
noisy_parse = false
noisy_search = false
noisy_events = false
noisy_flattened_events = false
noisy_find_all = false
font_size_px = 26
tray_font_size = 18
tabstop = 4
line_number_style = 'LineNumberStyle_Classic'
line_rulers = []

[[editor.highlights]]
color = 0x90b080ff
tags = ['keyword.directive',
'keyword.directive.define',
'keyword.directive.include',
'macro.function',
'macro.define',
'macro.definition']

[[editor.highlights]]
color = 0xd08f1fff
tags = ['keyword.alloc',
'keyword.return',
'keyword.repeat',
'keyword.conditional',
'keyword.conditional.ternary',
'keyword.exception',
'keyword.coroutine',
'keyword.coroutine.return']

[[editor.highlights]]

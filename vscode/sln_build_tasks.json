{
    "version":"2.0.0",
    "tasks": [
        {
	        "label": "MSBuild: x64 Debug",
	        "type": "shell",
	        "command": "MSBuild.exe",
	        "args": [
	        	"${workspaceFolder}/<solution_name>.sln",
	        	"/p:Configuration=Debug",
	        	"/p:platform=x64"
	        ],
	        "group": {
	        	"kind": "build",
	        	"isDefault": true 
	        },
	        "presentation": {
	        	"reveal": "always",
	        	"echo": true,
                "focus": false,
                "panel": "shared" 
	        },
            // matches output to MSBuild so that errors/warnings are mapped to correct files in the problems tab
	        "problemMatcher": [
                "$msCompile"
             ] 
	        
        },
        {
	        "label": "MSBuild: x64 Release",
	        "type": "shell",
	        "command": "C:/Program Files/Microsoft Visual Studio/2022/Community/MSBuild/current/Bin/MSBuild.exe",
	        "args": [
	        	"${workspaceFolder}/<solution_name>.sln",
	        	"/p:Configuration=Release",
	        	"/p:platform=x64",
	        ],
	        "group": {
	        	"kind": "build",
	        	"isDefault": false 
	        },
	        "presentation": {
	        	"reveal": "always",
	        	"echo": true,
                "focus": false,
                "panel": "shared" 
	        },
	        "problemMatcher": "$msCompile" 
	        
        }
    ]
}
